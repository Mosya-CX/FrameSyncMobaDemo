<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\Launcher\AppIcon.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>FrameSyncMobaLauncher</AssemblyName>
    <RootNamespace>FrameSyncMoba.GameLauncher</RootNamespace>
    <Version>1.3.1</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="CdnSigningPublicKey.pem"
                      LogicalName="FrameSyncMoba.GameLauncher.CdnSigningPublicKey.pem" />
    <Content Include="Assets\Launcher\**\*"
             Exclude="Assets\Launcher\AppIcon.png"
             CopyToOutputDirectory="Always"
             CopyToPublishDirectory="Always"
             ExcludeFromSingleFile="true" />
    <Content Include="launcher.cdn.json"
             CopyToOutputDirectory="Always"
             CopyToPublishDirectory="Always"
             ExcludeFromSingleFile="true" />
    <Content Include="CdnSigningPublicKey.pem"
             Condition="Exists('CdnSigningPublicKey.pem')"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
